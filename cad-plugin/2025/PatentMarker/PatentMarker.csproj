<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>PatentMarker</RootNamespace>
    <AssemblyName>PatentMarker</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- AutoCAD 2025+ 不需要复制输出 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- AutoCAD 2025/2026+ managed DLLs -->
  <!-- 请从 AutoCAD 2025+ 安装目录复制到 lib\ 目录 -->
  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>lib\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>lib\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>lib\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Framework-neutral source shared by all five edition projects. -->
  <!-- 复线差异：PatMarkCommand / PatSelectAllCommand 改用本目录 Commands\ 下
       的版本本地文件（MLeader F 方案），不再链接 Shared 版本。 -->
  <ItemGroup>
    <Compile Remove="IO\NumberIdentity.cs" />
    <Compile Remove="IO\PatSettings.cs" />
    <Compile Remove="IO\DictDiff.cs" />
    <Compile Remove="IO\DictConflict.cs" />
    <Compile Remove="IO\MarkingTextParser.cs" />
    <Compile Remove="I18n\Language.cs" />
    <Compile Remove="IO\PatEntityHelper.cs" />
    <Compile Remove="Palette\DictPaletteSession.cs" />
    <Compile Include="..\..\Shared\IO\NumberIdentity.cs" Link="IO\NumberIdentity.cs" />
    <Compile Include="..\..\Shared\IO\PatSettings.cs" Link="IO\PatSettings.cs" />
    <Compile Include="..\..\Shared\IO\DictDiff.cs" Link="IO\DictDiff.cs" />
    <Compile Include="..\..\Shared\IO\DictConflict.cs" Link="IO\DictConflict.cs" />
    <Compile Include="..\..\Shared\IO\MarkingTextParser.cs" Link="IO\MarkingTextParser.cs" />
    <Compile Include="..\..\Shared\I18n\Language.cs" Link="I18n\Language.cs" />
    <Compile Include="..\..\Shared\Cad\PatEntityHelper.cs" Link="IO\PatEntityHelper.cs" />
    <Compile Include="..\..\Shared\Palette\DictPaletteCadService.cs" Link="Palette\DictPaletteCadService.cs" />
    <Compile Include="..\..\Shared\Palette\DictPaletteWorkflow.cs" Link="Palette\DictPaletteWorkflow.cs" />
    <Compile Include="..\..\Shared\Palette\DictPaletteSession.cs" Link="Palette\DictPaletteSession.cs" />
    <Compile Include="..\..\Shared\Palette\DictPaletteViewRenderer.cs" Link="Palette\DictPaletteViewRenderer.cs" />
    <Compile Include="..\..\Shared\Commands\PatLeaderTextAttachment.cs" Link="Commands\PatLeaderTextAttachment.cs" />
    <Compile Include="..\..\Shared\Commands\PatBraceGeometry.cs" Link="Commands\PatBraceGeometry.cs" />
    <Compile Include="..\..\Shared\Commands\PatBraceEntity.cs" Link="Commands\PatBraceEntity.cs" />
    <Compile Include="..\..\Shared\Commands\PatBraceCommand.cs" Link="Commands\PatBraceCommand.cs" />
    <Compile Include="..\..\Shared\Diagnostics\PatDiagnostics.cs" Link="Diagnostics\PatDiagnostics.cs" />
    <Compile Include="..\..\Shared\Diagnostics\PatDoctorReport.cs" Link="Diagnostics\PatDoctorReport.cs" />
    <Compile Include="..\..\Shared\Diagnostics\PatDoctorCommand.cs" Link="Diagnostics\PatDoctorCommand.cs" />
    <Compile Include="..\..\Shared\Commands\PatCheckResult.cs" Link="Commands\PatCheckResult.cs" />
    <Compile Include="..\..\Shared\I18n\Strings.cs" Link="I18n\Strings.cs" />
    <Compile Include="..\..\Shared\Palette\ArbitrateDialog.cs" Link="Palette\ArbitrateDialog.cs" />
    <Compile Include="..\..\Shared\Palette\EditEntryDialog.cs" Link="Palette\EditEntryDialog.cs" />
    <Compile Include="..\..\Shared\Palette\PasteRecognizeDialog.cs" Link="Palette\PasteRecognizeDialog.cs" />
    <Compile Include="..\..\Shared\Palette\DictPaletteControl.cs" Link="Palette\DictPaletteControl.cs" />
    <Compile Include="..\..\Shared\Palette\PatPaletteCommand.cs" Link="Palette\PatPaletteCommand.cs" />
    <Compile Include="..\..\Shared\Styles\PatStyleInitializer.cs" Link="Styles\PatStyleInitializer.cs" />
  </ItemGroup>

  <!-- System.Text.Json 内置于 .NET 8，无需额外 NuGet 包 -->

</Project>
