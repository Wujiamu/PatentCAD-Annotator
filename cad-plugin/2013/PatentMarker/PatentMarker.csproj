<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C3D4E5F6-A7B8-6C7D-0E9F-1A2B3C4D5E6F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <RootNamespace>PatentMarker</RootNamespace>
    <AssemblyName>PatentMarker</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <!-- AutoCAD 2013/2014 managed DLLs (v19.x) -->
    <!-- 请从 AutoCAD 2013/2014 安装目录复制到 lib\ 目录 -->
    <Reference Include="acdbmgd">
      <HintPath>lib\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>lib\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>lib\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Newtonsoft.Json via NuGet (packages.config) -->
    <!-- 注意：13.0.x 包中 lib\net40 目录的 DLL 实际标记 TargetFramework=v4.5，
         在 v4.0 目标下编译会报 MSB3274；lib\net35 无 TFM 标记且 CLR4 兼容，
         发布时经 ILRepack 合并进 PatentMarker.dll（单文件部署）。
         HintPath 必须用 ..\..\packages（packages 在 cad-plugin\packages，与各版本平级）。 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\packages\Newtonsoft.Json.13.0.3\lib\net35\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="PatentMarkerApp.cs" />
    <Compile Include="IO\ConfigLoader.cs" />
    <Compile Include="IO\DictEntry.cs" />
    <Compile Include="IO\DictDiff.cs" />
    <Compile Include="IO\DictWriter.cs" />
    <Compile Include="IO\DictConflict.cs" />
    <Compile Include="IO\NumberIdentity.cs" />
    <Compile Include="IO\PatSettings.cs" />
    <Compile Include="IO\RuntimeHost.cs" />
    <Compile Include="IO\MarkingTextParser.cs" />
    <Compile Include="IO\PatEntityHelper.cs" />
    <Compile Include="Styles\PatStyleInitializer.cs" />
    <Compile Include="Commands\PatMarkCommand.cs" />
    <Compile Include="Commands\PatCheckCommand.cs" />
    <Compile Include="Commands\PatAlignCommand.cs" />
    <Compile Include="Commands\PatSelectAllCommand.cs" />
    <Compile Include="Palette\PatPaletteCommand.cs" />
    <Compile Include="Palette\DictPaletteControl.cs" />
    <Compile Include="Palette\DictPaletteSession.cs" />
    <Compile Include="Palette\PasteRecognizeDialog.cs" />
    <Compile Include="Palette\EditEntryDialog.cs" />
    <Compile Include="Palette\ArbitrateDialog.cs" />
    <Compile Include="I18n\Language.cs" />
    <Compile Include="I18n\Strings.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
