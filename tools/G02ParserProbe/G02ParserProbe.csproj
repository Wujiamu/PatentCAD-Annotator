<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>G02ParserProbe</AssemblyName>
    <RootNamespace>PatentMarker.G02Probe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8618;CS8625</NoWarn>
    <!-- Variant + parser path are supplied on the command line, e.g.
         dotnet build G02ParserProbe.csproj -c Release -p:Variant=red -p:ParserSourceFile=<path>
         Keeping them out of this file lets the same project compile the pre-fix snapshot
         and the working tree without editing the project. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(ParserSourceFile)' != ''">
    <!-- Production source under test. -->
    <Compile Include="$(ParserSourceFile)" Link="IO\MarkingTextParser.cs" />
  </ItemGroup>

</Project>
