# ============================================================
# PatentMarker 2007 - .gitignore
# ============================================================

# ---- 构建产物 ----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.pdb
*.exe

# ---- 例外：部署包中的 PatentMarker.dll（用户需要此文件） ----
!PatentMarker-*-deploy/PatentMarker.dll

# ---- 旧版 deploy 残留（已迁移到根目录 PatentMarker-*-deploy/） ----
cad-plugin/*/deploy/

# ---- AutoCAD SDK 专有 DLL（Autodesk 版权，禁止提交） ----
# acdbmgd.dll / acmgd.dll / probe.exe 由用户本机自备，放入 lib/
cad-plugin/*/PatentMarker/lib/*.dll
cad-plugin/*/PatentMarker/lib/*.exe
DLL/

# ---- 测试用 VBS 脚本 ----
*test*.vbs

# ---- 发布包 / 压缩包 ----
*.zip
PatentMarker-2007-v2*/

# ---- 截图与本地环境探测（含本机隐私信息） ----
shots-v2/
2007 版本运行环境/

# ---- IDE / 助手内部文件 ----
.trae/
.workbuddy/
.vs/
.qoder/
*.user
*.suo

# ---- 会话交接稿（临时文档，不入库） ----
docs/handoff-*.md

# ---- NuGet 包与本地构建支持（用户自备，不入库） ----
cad-plugin/packages/
cad-plugin/tools/

# ---- 第三方工具（ILRepack / 引用程序集下载，用户自备） ----
tools/ilrepack/
tools/net-ref-fetch/
tools/refasm/

# ---- 本地探针 / 复现工程 / 构建日志 ----
tools/MLeaderRepro/
tools/ApiSurfaceProbe/
tools/api-probe-*.txt
tools/msbuild-*.txt
tools/dotnet-*-log.txt
tools/patterns-slice.txt
tools/backup-*.vbs

# ---- AutoCAD 运行时残留 ----
acad.err

# ---- 日志 ----
*.log
PatentMarker.log

# ---- 部署包运行时产物 ----
*.bak.*
PatentMarker-*-deploy/PatentMarker-doctor-report.txt
# install-2025.ps1 生成的 LSP 兜底文件（内容含本机绝对路径，勿入库）
PatentMarker-*-deploy/load-patent-marker.lsp

# ---- 临时文件 ----
*.tmp
*.bak
~$*
/snap_*.png
/autocad_screen.png

# ---- 测试产物 / 临时测试文件 ----
test-single-export.vbs
test-single-output.txt
probe-results.rar
批量测试.rar
批量测试/
test-results/
MU26005942.2稿(1).docx
MU26005942.dict.json
