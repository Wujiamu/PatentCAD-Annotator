<Project Sdk="Microsoft.NET.Sdk">

  <!--
    G16 / R-034 language-level gate.

    Four of the five editions (2007/2010/2013/2015) link the changed Shared
    files into non-SDK projects whose compilers are older. This scratch project
    recompiles ONLY the changed Shared files at LangVersion=2 against minimal
    stubs, so a C# 3+ construct added by this fix fails here instead of in a
    legacy edition that cannot be built on this machine.

    This is an L0 (static/language) check. It proves nothing about runtime
    behaviour; the behavioural evidence is the red/green probe and the FactRunner
    unit tests.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>2</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>G16LangGate</AssemblyName>
    <OutputType>Library</OutputType>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\..\..\</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)cad-plugin\Shared\IO\DictConflict.cs" />
    <Compile Include="$(RepoRoot)cad-plugin\Shared\Palette\ArbitrateDialog.cs" />
    <Compile Include="$(RepoRoot)cad-plugin\Shared\Palette\DictPaletteWorkflow.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>

</Project>
